{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/humanities-courses/source-audit.schema.json",
  "title": "Course Source Audit Ledger",
  "type": "object",
  "required": ["schema_version", "checked_at", "scope", "count", "boundaries", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision", "source_title", "source_author", "access_mode", "method", "checked_at", "evidence", "academic_verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^hc-[0-9]{3}$" },
          "decision": { "enum": ["available", "content_mismatch", "unavailable"] },
          "source_title": { "type": ["string", "null"] },
          "source_author": { "type": ["string", "null"] },
          "access_mode": { "enum": ["free", "audit", "preview", "paid", "login_required", "unknown"] },
          "method": { "type": "string", "minLength": 1 },
          "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidence": { "type": "string", "minLength": 1 },
          "academic_verification": { "const": "not_completed" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
