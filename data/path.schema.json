{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/humanities-courses/path.schema.json",
  "title": "Humanities Learning Path Collection",
  "type": "object",
  "required": ["schema_version", "paths"],
  "properties": {
    "schema_version": { "const": 1 },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "path": {
      "type": "object",
      "required": ["id", "title", "status", "duration_weeks", "guiding_question", "audience", "outcomes", "nodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^path-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft_requires_academic_review", "pilot", "published", "archived"] },
        "duration_weeks": { "type": "integer", "minimum": 1 },
        "guiding_question": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "nodes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "week", "type", "title", "instruction", "course_ids", "scope_status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "week": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["orientation", "course", "primary_text", "practice", "reflection", "synthesis"] },
        "title": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "course_ids": { "type": "array", "items": { "type": "string", "pattern": "^hc-[0-9]{3}$" }, "uniqueItems": true },
        "scope_status": { "enum": ["not_applicable", "pending_lesson_index", "reviewed"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
