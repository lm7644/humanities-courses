{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/humanities-courses/course.schema.json",
  "title": "Humanities Course Record",
  "type": "object",
  "required": [
    "id", "name", "category", "platform", "teacher", "school", "title", "duration",
    "difficulty", "stage", "cover", "intro", "review", "url", "status", "schedule",
    "source_type", "source_title", "source_author", "source_duration_seconds", "source_pages",
    "access_mode", "availability", "link_checked_at", "verified_at", "verified_by",
    "verification_method", "rights_basis", "license_note", "language", "subtitles", "materials",
    "certificate", "effort_hours", "prerequisites", "outcomes", "tags", "quality_evidence",
    "perspective", "known_limits", "alternative_views", "editorial_status", "core"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^hc-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "teacher": { "type": "string", "minLength": 1 },
    "school": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "duration": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["入门", "进阶", "高阶"] },
    "stage": { "enum": ["入门", "进阶级", "研究向"] },
    "cover": { "type": "string" },
    "intro": { "type": "string", "minLength": 1 },
    "review": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "status": { "enum": ["always", "open", "closed", "upcoming", "needs_review", "unavailable"] },
    "schedule": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["platform_video", "platform_audio", "platform_course_page", "bilibili_series", "unknown"] },
    "source_title": { "type": ["string", "null"] },
    "source_author": { "type": ["string", "null"] },
    "source_duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
    "source_pages": { "type": ["integer", "null"], "minimum": 0 },
    "access_mode": { "enum": ["free", "audit", "preview", "paid", "login_required", "unknown"] },
    "availability": { "enum": ["available", "needs_review", "content_mismatch", "course_closed", "upcoming", "unavailable", "unknown"] },
    "link_checked_at": { "type": ["string", "null"] },
    "verified_at": { "type": ["string", "null"] },
    "verified_by": { "type": ["string", "null"] },
    "verification_method": { "type": ["string", "null"] },
    "rights_basis": { "enum": ["link_only", "platform_public_page", "explicit_permission", "unknown"] },
    "license_note": { "type": "string" },
    "language": { "enum": ["zh", "en", "mixed", "unknown"] },
    "subtitles": { "enum": ["available", "partial", "none", "unknown"] },
    "materials": { "enum": ["available", "partial", "none", "unknown"] },
    "certificate": { "enum": ["available", "paid", "none", "unknown"] },
    "effort_hours": { "type": ["number", "null"], "minimum": 0 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "outcomes": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "quality_evidence": { "type": "array", "items": { "type": "string" } },
    "perspective": { "type": "array", "items": { "type": "string" } },
    "known_limits": { "type": "array", "items": { "type": "string" } },
    "alternative_views": { "type": "array", "items": { "type": "string" } },
    "editorial_status": { "enum": ["core_candidate", "catalog_candidate", "blocked", "verified"] },
    "core": { "type": "boolean" },
    "pinyin": { "type": "string", "description": "构建期生成的全拼检索字段（派生自 name/school，构建工具写入）" },
    "_pinyinAbbr": { "type": "string", "description": "构建期生成的拼音首字母缩写检索字段（派生字段，下划线前缀）" },
    "series": {
      "type": "object",
      "description": "B站系列视频课程化结构，仅 source_type=bilibili_series 时填写",
      "required": ["up_owner", "total_pages", "collected_at"],
      "properties": {
        "up_owner": { "type": "string", "minLength": 1 },
        "total_pages": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "unit_hint": { "type": "string" },
        "collected_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "technique": {
      "type": "array",
      "description": "国画/书法技法分科（数组，可多值），其他分类留空数组",
      "items": { "enum": ["白描", "工笔", "没骨", "写意", "泼墨", "山水", "花鸟", "人物", "理论鉴赏", "篆书", "隶书", "楷书", "行书", "草书", "篆刻", "硬笔", "综合"] }
    },
    "medium": {
      "enum": ["软笔", "硬笔", "纸本设色", "纸本水墨", "unknown"],
      "description": "工具材料维度，用于组合筛选；unknown 为默认"
    }
  },
  "additionalProperties": false
}
